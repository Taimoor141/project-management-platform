# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-secure-random-secret
APP_NAME=ProjectFlow

# Optional first-owner bootstrap. Keep real values in .env, never in source control.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password
BOOTSTRAP_ADMIN_NAME=Workspace Admin
BOOTSTRAP_ADMIN_ORG_SLUG=admin-workspace

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_management

# Redis
REDIS_URL=redis://localhost:6379

# Optional future upload storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_NAME=projectflow-local
