generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum PresenceStatus {
  ONLINE
  AWAY
  OFFLINE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum ProjectVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  MENTION
  ORGANIZATION_INVITATION
  TASK_UPDATED
  PROJECT_ARCHIVED
  PROJECT_APPROVAL_REQUESTED
  TASK_APPROVAL_REQUESTED
  APPROVAL_DECISION
}

enum ActivityActionType {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_ASSIGNED
  MEMBER_ADDED
  MEMBER_REMOVED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  ORGANIZATION_MEMBER_ROLE_CHANGED
  PROJECT_APPROVED
  PROJECT_REJECTED
  TASK_APPROVED
  TASK_REJECTED
}

enum ConferenceStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum VoiceSignalType {
  OFFER
  ANSWER
  ICE
}

enum ChannelType {
  TEXT
  AUDIO
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeenAt    DateTime?
  presenceStatus PresenceStatus @default(OFFLINE)

  accounts           Account[]
  sessions           Session[]
  orgMemberships     OrganizationMember[]
  projectMemberships ProjectMember[]
  createdOrganizations Organization[] @relation("OrganizationOwner")
  createdProjects     Project[] @relation("ProjectCreator")
  tasksCreated        Task[] @relation("TaskReporter")
  tasksAssigned       Task[] @relation("TaskAssignee")
  comments            Comment[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  invitationsSent    OrganizationInvitation[] @relation("InvitationInviter")
  attachments        Attachment[]
  labelsCreated      Label[]
  hostedConferences  ConferenceCall[] @relation("ConferenceHost")
  createdAudioChannels AudioChannel[]
  channelMessages    ChannelMessage[]
  voiceParticipants  VoiceParticipant[]
  voiceSignalsSent   VoiceSignal[] @relation("VoiceSignalSender")
  voiceSignalsReceived VoiceSignal[] @relation("VoiceSignalRecipient")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  accessCode  String?   @unique
  description String?
  logoUrl     String?
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  owner       User @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     OrganizationMember[]
  projects    Project[]
  invitations OrganizationInvitation[]
  notifications Notification[]
  activityLog ActivityLog[]
  audioChannels AudioChannel[]
}

model OrganizationMember {
  id            String       @id @default(cuid())
  organizationId String
  userId        String
  role          Role
  status        MemberStatus @default(ACTIVE)
  joinedAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, userId])
  @@index([userId, organizationId])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  invitedByUserId String
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([email])
  @@index([status, expiresAt])
}

model Project {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  key            String
  description    String?
  status         ProjectStatus     @default(ACTIVE)
  visibility     ProjectVisibility @default(PRIVATE)
  archivedAt     DateTime?
  approvalStatus ApprovalStatus    @default(APPROVED)
  approvedByUserId String?
  approvedAt     DateTime?
  rejectionReason String?
  rejectionPermanent Boolean       @default(false)
  createdByUserId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  tasks        Task[]
  activityLog  ActivityLog[]
  audioChannels AudioChannel[]

  @@unique([organizationId, key])
  @@index([organizationId, status, approvalStatus, archivedAt])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, userId])
}

model AudioChannel {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  name           String
  type           ChannelType @default(AUDIO)
  description    String?
  createdByUserId String
  createdAt      DateTime @default(now())
  archivedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  conferences  ConferenceCall[]
  messages     ChannelMessage[]
  voiceParticipants VoiceParticipant[]
  voiceSignals VoiceSignal[]

  @@index([organizationId, archivedAt])
  @@index([projectId])
}

model ChannelMessage {
  id        String   @id @default(cuid())
  channelId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  channel AudioChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model ConferenceCall {
  id           String           @id @default(cuid())
  channelId    String
  title        String
  scheduledFor DateTime?
  status       ConferenceStatus @default(SCHEDULED)
  hostUserId   String
  createdAt    DateTime         @default(now())
  endedAt      DateTime?

  channel AudioChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  host    User @relation("ConferenceHost", fields: [hostUserId], references: [id], onDelete: Restrict)

  @@index([channelId, status, scheduledFor])
}

model VoiceParticipant {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  updatedAt DateTime @updatedAt

  channel AudioChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId, updatedAt])
}

model VoiceSignal {
  id         String          @id @default(cuid())
  channelId  String
  senderId   String
  recipientId String
  type       VoiceSignalType
  payload    Json
  createdAt  DateTime        @default(now())

  channel   AudioChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender    User         @relation("VoiceSignalSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User         @relation("VoiceSignalRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([channelId, recipientId, createdAt])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  reporterId  String
  dueDate     DateTime?
  completedAt DateTime?
  archivedAt  DateTime?
  approvalStatus ApprovalStatus @default(APPROVED)
  approvedByUserId String?
  approvedAt DateTime?
  rejectionReason String?
  rejectionPermanent Boolean @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  comments    Comment[]
  attachments Attachment[]
  labels      TaskLabel[]
  activityLog ActivityLog[]

  @@index([projectId, status, approvalStatus, updatedAt])
  @@index([projectId, assigneeId, dueDate])
  @@index([projectId, priority])
  @@index([assigneeId, status])
  @@index([dueDate])
}

model Label {
  id             String   @id @default(cuid())
  organizationId  String
  name           String
  color          String
  createdByUserId String
  createdAt      DateTime @default(now())

  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  tasks     TaskLabel[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TaskLabel {
  id      String @id @default(cuid())
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  taskId     String
  uploaderId String
  fileName   String
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model Notification {
  id             String          @id @default(cuid())
  recipientUserId String
  organizationId  String?
  type           NotificationType
  entityType     String?
  entityId       String?
  message        String
  isRead         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  readAt         DateTime?

  recipient  User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead, createdAt])
  @@index([organizationId, createdAt])
}

model ActivityLog {
  id            String            @id @default(cuid())
  organizationId String
  projectId     String?
  taskId        String?
  actorUserId   String?
  actionType    ActivityActionType
  actionDetail  String?
  ipHash        String?
  createdAt     DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor        User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorUserId, createdAt])
}
